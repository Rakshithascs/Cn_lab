#include <bits/stdc++.h>
using namespace std;
int main() {
    int b, r, n;
    cout << "Bucket Size: ";
    cin >> b;
    cout << "Output Rate: ";
    cin >> r;
    cout << "No. of Packets: ";
    cin >> n;

    int rem = 0;
    for (int i = 1; i <= n; i++) {
        int s;
        cout << "Packet " << i << " size: ";
        cin >> s;
        if (s + rem > b) {
            cout << "Packet " << i << " Dropped! Bucket Overflow\n";
        } else {
            rem = rem + s;
            cout << "Packet " << i << " Accepted, Bucket = " << rem << endl;
            rem = rem - r;
            if (rem < 0) rem = 0;
            cout << "After Leak, Bucket = " << rem << endl;
        }
    }
    return 0;
}
