#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cout << "Enter number of nodes: ";
    cin >> n;

    int cost[10][10];
    cout << "Enter cost matrix (999 = no link):\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
        }
    }

    int src;
    cout << "Enter source node: ";
    cin >> src;

    int dist[10];
    int visited[10] = {0};

    for (int i = 0; i < n; i++) {
        dist[i] = cost[src][i];
    }
    dist[src] = 0;
    visited[src] = 1;

    for (int k = 1; k < n; k++) {
        int minDist = 999;
        int u = -1;

        // Pick unvisited node with minimum distance
        for (int i = 0; i < n; i++) {
            if (!visited[i] && dist[i] < minDist) {
                minDist = dist[i];
                u = i;
            }
        }

        visited[u] = 1;

        // Update neighbours of u
        for (int v = 0; v < n; v++) {
            if (!visited[v] && dist[u] + cost[u][v] < dist[v]) {
                dist[v] = dist[u] + cost[u][v];
            }
        }
    }

    cout << "\nShortest Path from node " << src << ":\n";
    for (int i = 0; i < n; i++) {
        cout << src << " -> " << i << " = " << dist[i] << endl;
    }

    return 0;
}
